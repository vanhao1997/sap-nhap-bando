{
  "name": "sap-nhap-bando",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data:build": "node scripts/build-data.mjs",
    "coolify:install": "curl -fsSL https://nodejs.org/dist/v22.14.0/node-v22.14.0-linux-x64.tar.xz -o /tmp/node22.tar.xz && mkdir -p /tmp/node22 && tar -xJf /tmp/node22.tar.xz -C /tmp/node22 --strip-components=1 && /tmp/node22/bin/node -v && rm -f package-lock.json && PATH=/tmp/node22/bin:$PATH npm install --include=optional",
    "coolify:build": "PATH=/tmp/node22/bin:$PATH npm run build",
    "dev": "vite",
    "build": "npm run data:build && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "hyparquet": "^1.25.8",
    "hyparquet-compressors": "^1.1.1",
    "iconv-lite": "^0.7.2",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "fuse.js": "^7.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0"
  }
}
